9:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo and third-party service providers may use cookies, local storage, pixels, tags, or similar technologies to operate the website, remember preferences, understand website usage, improve performance, measure traffic, and support advertising."}]
a:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Some cookies or similar technologies may be placed by third-party providers rather than directly by ElDevo. You can control or delete cookies through your browser settings. Disabling certain cookies may affect some website functionality."}]
b:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"4. Google Analytics"}]
c:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo may use Google Analytics to understand how visitors use the website and to improve its performance, content, and user experience."}]
d:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Google Analytics may collect information such as pages visited, interactions with the website, browser and device information, approximate geographic information, traffic sources, and other technical or usage data."}]
e:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Google Analytics may use cookies and similar technologies to help measure website usage. Information processed through Google Analytics is handled by Google according to Google's applicable terms and privacy policies."}]
f:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Where required by applicable law, ElDevo may request user consent before enabling analytics technologies or provide appropriate privacy controls."}]
10:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"5. Google Search Console"}]
11:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo may use Google Search Console to monitor the website's presence and performance in Google Search, identify technical problems, understand search visibility, and improve the website."}]
12:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Google Search Console is primarily an administrative and search performance service. ElDevo does not use Search Console as a general visitor analytics service."}]
13:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"6. Advertising"}]
14:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo may introduce advertising on the website in the future through third-party advertising providers, including Google AdSense."}]
15:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"If advertising services are enabled, advertising providers may use cookies or similar technologies to deliver, personalize, measure, or limit advertising, subject to applicable laws, user consent requirements, and the providers' policies."}]
16:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Advertising practices and available privacy controls may vary depending on your location, applicable regulations, and your consent choices."}]
17:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"7. Third-Party Services"}]
18:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo may rely on third-party providers for hosting, security, analytics, search performance monitoring, content delivery, advertising, and other website functionality."}]
19:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Third-party providers may process information according to their own privacy policies, terms of service, and applicable laws. ElDevo recommends reviewing the privacy policies of relevant third-party services when appropriate."}]
1a:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"8. How Information May Be Used"}]
1b:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Information processed through ElDevo or its supporting services may be used to:"}]
1c:["$","ul",null,{"className":"mt-3 list-disc space-y-2 pl-6 leading-7 text-slate-400","children":[["$","li",null,{"children":"Operate and maintain the website."}],["$","li",null,{"children":"Provide and improve developer tools."}],["$","li",null,{"children":"Understand website usage and performance."}],["$","li",null,{"children":"Identify and resolve technical problems."}],["$","li",null,{"children":"Protect the website against abuse, fraud, and security threats."}],["$","li",null,{"children":"Measure traffic and search performance."}],["$","li",null,{"children":"Support advertising where advertising is enabled."}],["$","li",null,{"children":"Comply with applicable legal obligations."}]]}]
1d:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"9. Data Security"}]
1e:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"We take reasonable measures to protect the website and information processed through our services. However, no website, internet transmission, or electronic storage system can be guaranteed to be completely secure."}]
1f:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Users are responsible for taking reasonable precautions when using online developer tools and should avoid submitting sensitive information unless they understand the applicable processing model."}]
20:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"10. Data Retention"}]
21:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo does not intentionally retain locally processed tool input on an ElDevo application server when the relevant tool performs its operation entirely within the browser."}]
22:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Information processed by third-party services, such as analytics, hosting, security, or advertising providers, may be retained according to their respective policies and applicable legal requirements."}]
23:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"11. Children's Privacy"}]
24:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo is not intended to knowingly collect personal information from children. If you believe that a child has provided personal information through the website, please contact us so that appropriate action can be taken."}]
25:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"12. Your Privacy Rights and Choices"}]
26:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"Depending on your location and applicable law, you may have rights regarding your personal information. These rights may include requesting access to, correction of, deletion of, or restriction of certain processing of your personal information."}]
27:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"You may also have choices regarding cookies, analytics, and personalized advertising. Available rights and controls may vary depending on your jurisdiction and the services being used."}]
28:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"13. International Users"}]
29:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"ElDevo may be accessed by users from different countries. Information processed by ElDevo or its third-party providers may be transferred to and processed in countries other than the country where you are located, subject to applicable laws and the relevant provider's policies."}]
2a:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"14. Changes to This Privacy Policy"}]
2b:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"We may update this Privacy Policy from time to time to reflect changes to the website, services, technology, or applicable legal requirements."}]
2c:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"When changes are made, the updated version will be posted on this page and the \"Last updated\" date will be revised."}]
2d:["$","h2",null,{"className":"mt-10 text-xl font-semibold","children":"15. Contact Us"}]
2e:["$","p",null,{"className":"mt-3 leading-7 text-slate-400","children":"If you have questions, concerns, or requests regarding this Privacy Policy or ElDevo's privacy practices, please contact us through the contact information provided on the ElDevo website."}]
